{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.appdoiten.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "os.showOpenDialog",
    "os.execCommand",
    "filesystem.getStats",
    "filesystem.move"
  ],
  "modes": {
    "window": {
      "title": "App đổi tên file cho Bé",
      "width": 1100,
      "height": 750,
      "minWidth": 760,
      "minHeight": 500,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "AppDoiTen",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
